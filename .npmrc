# A handful of tarball URLs inside package-lock.json were pinned to a
# regional mirror (registry.npmmirror.com) when the lockfile was generated.
# `always` rewrites every resolved host to the registry configured below,
# which keeps `npm ci` working regardless of the contributor's region.
# If you are behind a regional mirror yourself, point `registry` at it —
# the flag simply makes registry selection a local choice again.
registry=https://registry.npmjs.org/
replace-registry-host=always
