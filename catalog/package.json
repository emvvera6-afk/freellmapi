{
  "name": "@freellmapi/catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Catalog + licensing service: signed model-catalog feed, license keys, Stripe billing, landing page.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run --pool=forks --fileParallelism=false",
    "keygen": "tsx scripts/keygen.ts",
    "sign": "tsx scripts/sign-catalog.ts",
    "promote-monthly": "tsx scripts/sign-catalog.ts --promote-monthly",
    "create-key": "tsx scripts/create-key.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "compression": "^1.8.0",
    "express": "^5.1.0",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=20.18.0 <25.0.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.10.0"
  }
}
