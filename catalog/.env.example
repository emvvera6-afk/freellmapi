# ── Catalog + licensing service configuration ─────────────────────────────
# Copy to .env (never committed — .gitignore covers it).

# HTTP
PORT=8780

# Where state lives: SQLite DB (licenses.db) + catalog JSON products
# (catalog.live.json, catalog.monthly.json + their .sig signatures).
# On hosts with ephemeral disks (Render free), BACKUP_* below keeps state
# safe across redeploys.
DATA_DIR=./data

# ── Brand (drives the landing page + emails) ──
BRAND_NAME=YourBrand
BRAND_DOMAIN=yourbrand.example
SITE_URL=https://yourbrand.example
GITHUB_URL=https://github.com/your-org/your-repo
SUPPORT_EMAIL=support@yourbrand.example

# Displayed prices (the REAL prices live in Stripe when Stripe is used).
PRICE_ANNUAL_USD=19
PRICE_LIFETIME_USD=79

# ── Checkout mode: stripe | manual (blank = auto: stripe if configured) ──
# manual = /buy order form with the payment rails below; you confirm payments
# and fulfill via /v1/admin/orders/:id/fulfill. $0 payment processing.
CHECKOUT_MODE=

# ── Manual payment rails (shown on /buy and order emails; all optional) ──
PAY_USDT_ADDRESS=
PAY_PAYPAL_URL=
PAY_NOTE=

# Shared secret for POST /v1/admin/orders/:id/fulfill (REQUIRED in manual mode)
# Generate: openssl rand -hex 24
ADMIN_TOKEN=

# ── Stripe (when you outgrow manual mode — set CHECKOUT_MODE=stripe or leave
# blank for auto) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_LIFETIME=

# ── Email ──
# $0 option: SendGrid free tier (100/day) with "single sender verification"
# against a Gmail address — no own domain needed.
SENDGRID_API_KEY=
# Alternative: Resend (needs a verified sending domain).
RESEND_API_KEY=
# EMAIL_PROVIDER=sendgrid|resend   (blank = auto from whichever key is set)
EMAIL_FROM=Tienda <tu.correo@gmail.com>

# ── State backup to GitHub (survive ephemeral free hosts) ──
# A PRIVATE repo holding licenses.db. Fine-grained PAT with contents:write
# on that one repo. Service restores on boot, pushes (debounced) after every
# state change.
BACKUP_GITHUB_REPO=
BACKUP_GITHUB_TOKEN=
BACKUP_GITHUB_PATH=backups/licenses.db
BACKUP_GITHUB_BRANCH=main

# License key text prefix, e.g. PRO-XXXX-XXXX-XXXX-XXXX
LICENSE_KEY_PREFIX=PRO

# ── Signing (ONLY used by `npm run sign` / `promote-monthly`, never at
# request time — the running server holds no catalog secrets) ──
# Generate with `npm run keygen`. The matching PUBLIC key is pinned in the
# router app (server/src/services/catalog-sync.ts) that ships to users.
CATALOG_PRIVKEY=
