# ── Catalog + licensing service configuration ─────────────────────────────
# Copy to .env (never committed — .gitignore covers it).

# HTTP
PORT=8780

# Where state lives: SQLite DB (licenses.db) + catalog JSON products
# (catalog.live.json, catalog.monthly.json + their .sig signatures).
# In Docker, mount a volume here.
DATA_DIR=./data

# ── Brand (drives the landing page + emails) ──
BRAND_NAME=YourBrand
BRAND_DOMAIN=yourbrand.example
SITE_URL=https://yourbrand.example
GITHUB_URL=https://github.com/your-org/your-repo
SUPPORT_EMAIL=support@yourbrand.example

# Displayed prices (the REAL prices live in Stripe — these are cosmetic).
PRICE_ANNUAL_USD=19
PRICE_LIFETIME_USD=79

# ── Stripe ──
# Leave blank to boot in degraded mode (catalog feed + manual keys keep
# working; checkout/portal/webhooks answer 503).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_LIFETIME=

# ── Transactional email (Resend — https://resend.com) ──
# Leave blank to log emails to stdout instead of sending.
RESEND_API_KEY=
EMAIL_FROM=Licenses <licenses@yourbrand.example>

# License key text prefix, e.g. PRO-XXXX-XXXX-XXXX-XXXX
LICENSE_KEY_PREFIX=PRO

# ── Signing (ONLY used by `npm run sign` / `promote-monthly`, never at
# request time — the running server holds no catalog secrets) ──
# Generate with `npm run keygen`. The matching PUBLIC key is pinned in the
# router app (server/src/services/catalog-sync.ts) that ships to users.
CATALOG_PRIVKEY=
